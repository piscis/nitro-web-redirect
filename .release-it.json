{
  "git": {
    "requireBranch": "release/*",
    "requireUpstream": false,
    "commitMessage": "chore(release): v${version}",
    "tag": false,
    "push": false
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits",
        "issuePrefixes": ["\u0000"]
      },
      "header": "# Changelog",
      "context": {
        "host": "https://github.com",
        "owner": "piscis",
        "repository": "nitro-web-redirect"
      }
    }
  }
}
