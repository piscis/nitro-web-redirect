# For external developers and anyone self-hosting a fork: copy this file to `.env`
# and run `pnpm dev:local`.
#
# Maintainers do not need it. `pnpm dev` and `pnpm preview` pull these two variables
# from Phase; see "Development configuration" in the README.
#
# Neither value is a secret: in production the container takes the same two variables
# from its environment.

REDIRECT_TARGET='https://example.com'
REDIRECT_STATUS_CODE=302
