{
  "name": "nitro-web-redirect",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "rimraf .output .nitro node_modules",
    "start": "node .output/server/index.mjs",
    "build": "nitro build",
    "dev": "nitro dev",
    "preview": "nitro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest --run",
    "release": "release-it --ci",
    "release:patch": "release-it -i patch --only-version",
    "release:minor": "release-it -i minor --only-version",
    "release:major": "release-it -i major --only-version"
  },
  "dependencies": {
    "consola": "^3.4.2"
  },
  "imports": {
    "#*": "./*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "nitro": "3.0.261103-rc",
    "nitro-test-utils": "^4.0.1",
    "release-it": "^21.1.2",
    "rimraf": "^6.1.4",
    "rolldown": "^1.2.15",
    "ufo": "^1.6.4",
    "vitest": "^5.1.0"
  }
}
